/*
  secrets.h.example  —  template for your WiFi credentials.

  SETUP: copy this file to "secrets.h" in this same folder, then fill in the
  real values. The firmware will not compile until you do — sign_on.cpp includes
  secrets.h directly.

      cp secrets.h.example secrets.h

  secrets.h is gitignored. Never commit it, and never put real credentials in
  THIS file — it IS committed.
*/

#ifndef SECRETS_H
#define SECRETS_H

// ---------------------------------------------------------------------------
// Private WiFi (plain WPA2) — tried first.
// ---------------------------------------------------------------------------
#define NOAH_IDENTITY   "your-wifi-ssid"
#define NOAH_PASSWORD   "your-wifi-password"

// ---------------------------------------------------------------------------
// eduroam (WPA2-Enterprise, PEAP) — the fallback if the private network is
// out of range.
//
// Some institutions want EAP_IDENTITY to be "anonymous@uoguelph.ca"; others
// want it identical to EAP_USERNAME. If sign-on fails, try it the other way.
// ---------------------------------------------------------------------------
#define EAP_IDENTITY    "you@uoguelph.ca"
#define EAP_USERNAME    "you@uoguelph.ca"
#define EAP_PASSWORD    "your-eduroam-password"

#endif  // SECRETS_H
